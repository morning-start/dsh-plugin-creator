{
  "name": "dsh-plugin-powerful",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plugin-development toolkit for DeepSeek Harness: adds bundle and skill checks plus bundled skills to Creator mode only.",
  "exports": {
    ".": "./index.js",
    "./tools": "./tools/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "new": "node scripts/new-bundle.mjs",
    "sandbox": "node scripts/sandbox.mjs",
    "release": "node scripts/release.mjs",
    "check:patch": "node scripts/check-patch.mjs .",
    "check:skills": "node scripts/check-skills.mjs",
    "check:generate": "node scripts/try-generate.mjs",
    "check:sandbox": "node scripts/try-sandbox.mjs",
    "check:release": "node scripts/try-release.mjs",
    "check:tool": "node scripts/try-tool.mjs ."
  },
  "files": [
    "index.js",
    "lib",
    "templates",
    "tools",
    "skills",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
