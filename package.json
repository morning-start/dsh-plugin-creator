{
  "name": "dsh-plugin-creator",
  "version": "0.1.3",
  "type": "module",
  "description": "Plugin-development toolkit for DeepSeek Harness: adds bundle and skill checks plus bundled skills to Creator mode only.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morning-start/dsh-plugin-creator.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./index.js",
    "./tools": "./tools/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "new": "node scripts/new-bundle.mjs",
    "sandbox": "node scripts/sandbox.mjs",
    "release": "node scripts/release.mjs",
    "check:patch": "node scripts/check-patch.mjs .",
    "check:skills": "node scripts/check-skills.mjs",
    "check:generate": "node scripts/try-generate.mjs",
    "check:sandbox": "node scripts/try-sandbox.mjs",
    "check:release": "node scripts/try-release.mjs",
    "ui": "node scripts/ui.mjs",
    "check:ui": "node scripts/try-ui.mjs",
    "check:project": "node scripts/check-project.mjs .",
    "check:checks": "node scripts/try-checks.mjs",
    "check:audit": "node scripts/try-audit.mjs",
    "check:market": "node scripts/try-market.mjs",
    "market": "node scripts/market-entry.mjs",
    "contract": "node scripts/gen-tools-contract.mjs --write",
    "check:tool": "node scripts/try-tool.mjs .",
    "check:adopt": "node scripts/try-adopt.mjs",
    "adopt": "node scripts/adopt.mjs"
  },
  "files": [
    "index.js",
    "lib",
    "templates",
    "tools",
    "skills",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "errors",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
