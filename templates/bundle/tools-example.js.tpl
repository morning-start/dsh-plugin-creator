/**
 * {{toolName}} — replace this example with the tool you actually need.
 *
 * A tool definition is a plain object; no schema builder is needed, which keeps
 * this package dependency-free. `parameters` and `output.schema` are raw JSON
 * Schema: `required` is an array on the object node, and a property's own
 * `description` is where parameter rules belong.
 */
export const exampleTool = {
  name: '{{toolName}}',
  description: 'Example tool generated by dsh-plugin-powerful. Echoes the message it receives.',
  parameters: {
    type: 'object',
    properties: {
      message: {
        type: 'string',
        description: 'Text to echo back. Defaults to "ok" when omitted.',
      },
    },
  },
  output: {
    schema: {
      type: 'object',
      properties: {
        message: { type: 'string', description: 'The text that was echoed.' },
      },
      required: ['message'],
    },
    render: (_args, value) => [{ type: 'text', text: value.message }],
  },
  async execute(args) {
    return { message: typeof args.message === 'string' ? args.message : 'ok' }
  },
}
