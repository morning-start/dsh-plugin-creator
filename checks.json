{
  "version": 1,
  "description": "Project checks for this bundle. Rules are data; see docs/CHECKS.md.",
  "rules": [
    {
      "id": "docs:links",
      "type": "doc-links",
      "exclude": [
        "\\.dsh-memory/",
        "^tmp/"
      ]
    },
    {
      "id": "locale:parity",
      "type": "locale-parity",
      "files": [
        "locale/en.json",
        "locale/zh.json"
      ]
    },
    {
      "id": "contract:tools",
      "type": "contract-drift",
      "file": "docs/contracts/tools.json",
      "generator": "node scripts/gen-tools-contract.mjs"
    },
    {
      "id": "bundle:entry",
      "type": "file-exists",
      "path": "index.js"
    },
    {
      "id": "bundle:patch",
      "type": "json-field",
      "path": "package.json",
      "field": "dsh.bundle.patch",
      "equals": "./cordis.patch.yml"
    },
    {
      "id": "contract:ci-template",
      "type": "contract-drift",
      "file": "templates/bundle/github-release.yml.tpl",
      "generator": "node scripts/gen-ci-template.mjs"
    },
    {
      "id": "session:messages",
      "type": "session-message-identity",
      "root": ".",
      "exclude": [
        "^tmp/",
        "^node_modules/"
      ]
    },
    {
      "id": "inject:declared",
      "type": "undeclared-inject",
      "root": ".",
      "exclude": [
        "^tmp/",
        "^node_modules/",
        "^scripts/"
      ]
    },
    {
      "id": "depends:bare-name",
      "type": "bare-name-dependency",
      "root": ".",
      "exclude": [
        "^tmp/",
        "^node_modules/",
        "^scripts/"
      ]
    },
    {
      "id": "manifest:dsh-shape",
      "type": "manifest-shape",
      "manifest": "package.json"
    },
    {
      "id": "session:custom-event",
      "type": "custom-session-event",
      "root": ".",
      "exclude": [
        "^tmp/",
        "^node_modules/"
      ]
    },
    {
      "id": "errors:cards",
      "type": "errors-card"
    },
    {
      "id": "templates:variants",
      "type": "template-variants",
      "directory": "templates/bundle"
    },
    {
      "id": "release:pipeline",
      "type": "release-pipeline",
      "workflow": ".github/workflows/release.yml"
    }
  ]
}
